<body>
  <div class="page">

    <!-- Верхня панель -->
    <header class="top-bar">
        <a class="brand" href="./index.html" aria-label="Prybambas">
            <svg viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <circle cx="19" cy="14" r="9" fill="#FFE800" style="mix-blend-mode:multiply"/>
                <circle cx="14" cy="14" r="9" stroke="#1A1A2E" stroke-width="2.6"/>
                <path d="M20.5 20.5 L29 29" stroke="#1A1A2E" stroke-width="3" stroke-linecap="round"/>
            </svg>
            <span>Prybambas</span>
        </a>
        <nav class="top-nav">
            <a href="/en/ideas/" id="lnk-ideas">Ideas</a>
            <a href="/en/shop/" id="lnk-shop">Shop</a>
        </nav>
        <div class="top-actions">
            <!-- Розумна кнопка встановлення додатку -->
            <button class="install-btn" id="install-pwa-btn" onclick="triggerInstall()">Install App</button>

            <select class="lang-switch" id="lang-selector" onchange="changeLang()" aria-label="Language" data-lang-select></select><script src="./assets/langs.js"></script>
        </div>
    </header>

    <!-- Герой -->
    <section class="hero">
        <h1 id="hero-title">What if you <mark>look</mark> a little closer?</h1>
        <p id="hero-sub">A place where kids ask questions, notice small things and check the answers. Even the ones AI gives.</p>
        <div class="hero-note" aria-hidden="true">
            <span class="hand" id="hero-note">every “why?” counts!</span>
            <svg viewBox="0 0 70 44" fill="none" stroke="#D61F86" stroke-width="2.2" stroke-linecap="round"><path d="M62 4 C 48 22, 30 32, 8 36"/><path d="M8 36 l10 -8 M8 36 l12 3"/></svg>
        </div>
    </section>

    <!-- Сітка просторів -->
    {{ gameGrid(catalog.gameCards("en"), true) }}

    {% include "home-teasers.njk" %}

<!-- Текст для батьків, вчителів і AI-пошуку. Згорнуті блоки не заважають. -->
    <section class="seo-info" lang="en">
      <h2>What is Prybambas?</h2>
      <p class="lead">Prybambas is a free collection of thinking games for kids ages 5–14. Children explore cause and effect, solve inventor puzzles and practise languages — in the browser, with no login and no ads, in 15 languages.</p>
      <p>It is made for parents, teachers, homeschoolers and multilingual families who want screen time that builds curiosity, logic and creativity — and the habit of checking answers, even the ones AI gives.</p>

      <details>
        <summary>Which games are included?</summary>
        <ul>
          <li><a href="/what-if/"><strong>What If?</strong></a> — a cause-and-effect logic game with three modes: single question, logical chain and deduction.</li>
          <li><a href="/inventor/"><strong>Inventor Lab</strong></a> — creative problem solving with 8 TRIZ tools, a 30-day observation calendar, challenges and missions.</li>
          <li><a href="/coach/"><strong>AI Coach</strong></a> — language practice that pairs with the <em>One Verb a Day</em> workbooks.</li>
          <li><a href="/book/"><strong>Books Gym</strong></a> — printed workbooks that match the games.</li>
        </ul>
      </details>

      <details>
        <summary>Who is it for?</summary>
        <p>Children ages 5–14. Younger kids (5–7) usually play with a parent; older kids play on their own. Teachers use the games as warm-ups, discussion starters and logic lessons — students need no accounts.</p>
      </details>

      <details>
        <summary>Do I need to install anything?</summary>
        <p>No. Prybambas opens in any modern browser on phone, tablet or computer. You can also add it to the home screen so it opens like an app.</p>
      </details>

      <p class="more"><a href="/about.html">About</a> · <a href="/faq.html">FAQ</a> · <a href="/en/ideas/">Ideas for the dinner table</a></p>
    </section>

    <footer class="foot">
        <a href="./about.html" id="lnk-about">About</a>
        <a href="./faq.html" id="lnk-faq">FAQ</a>
        <span>© Prybambas by Kids Skill Academy</span>
    </footer>
  </div>

    <!-- Вікно-інструкція для користувачів iPhone -->
    <div class="ios-modal" id="ios-install-modal" role="dialog" aria-labelledby="ios-title">
        <h3 id="ios-title">Install App</h3>
        <p id="ios-desc">Follow these simple steps to install the app on your iPhone:</p>

        <div class="ios-modal-step">
            <span class="icon">📤</span>
            <span id="ios-step-1">1. Tap the "Share" button in Safari's bottom toolbar.</span>
        </div>
        <div class="ios-modal-step">
            <span class="icon">➕</span>
            <span id="ios-step-2">2. Scroll down and select "Add to Home Screen".</span>
        </div>

        <button class="ios-modal-close" onclick="closeIosModal()" id="ios-btn-close">Got It</button>
    </div>

    <script>
        // Тексти головної (src/_data/home.json) і картки ігор (content/games) усіма мовами
        const HOME = {{ home | json | safe }};
        const GAMES = {{ catalog.homeData | json | safe }};
        const SITE_LANGS = {{ site.languages | json | safe }};
        let deferredPrompt = null;
        let isIos = false;

        function changeLang() {
            const lang = document.getElementById('lang-selector').value;
            localStorage.setItem('prybambas_lang', lang);
            
            const t = HOME[lang] || HOME.en;
            const g = (GAMES[lang] || GAMES.en).games;

            // Картки ігор
            g.forEach(x => {
                const set = (id, v) => { const el = document.getElementById(id); if (el && v != null) el.innerText = v; };
                set('lbl-' + x.slug, x.title); set('tag-' + x.slug, x.tag); set('desc-' + x.slug, x.desc);
            });

            // Герой і посилання
            document.getElementById('hero-title').innerHTML = t.h1;
            document.getElementById('hero-sub').innerText = t.sub;
            document.getElementById('hero-note').innerText = t.note;
            document.getElementById('lnk-about').innerText = t.about;
            document.getElementById('lnk-faq').innerText = t.faq;
            // Магазин та ідеї є мовами з site.yml; для інших мов ведемо на англійську версію
            const siteLang = SITE_LANGS.includes(lang) ? lang : 'en';
            document.getElementById('lnk-ideas').innerText = t.ideas;
            document.getElementById('lnk-ideas').href = '/' + siteLang + '/ideas/';
            document.getElementById('lnk-shop').innerText = t.shop;
            document.getElementById('lnk-shop').href = '/' + siteLang + '/shop/';
            if (window.renderTeasers) window.renderTeasers(siteLang);
            document.documentElement.lang = lang;
            document.documentElement.dir = (lang === 'he' || lang === 'ar') ? 'rtl' : 'ltr';

            // Оновлення текстів кнопки встановлення
            const btn = document.getElementById('install-pwa-btn');
            if (btn) btn.innerText = t.install;

            // Оновлення текстів модалки iOS
            document.getElementById('ios-title').innerText = t.ios_title;
            document.getElementById('ios-desc').innerText = t.ios_desc;
            document.getElementById('ios-step-1').innerText = t.ios_step1;
            document.getElementById('ios-step-2').innerText = t.ios_step2;
            document.getElementById('ios-btn-close').innerText = t.ios_close;
        }

        // Обробка події встановлення PWA на Android/Chrome
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault(); // Запобігаємо автоматичному спливанню дефолтного вікна
            deferredPrompt = e; // Зберігаємо подію
            
            // Показуємо кнопку встановлення для Android
            const installBtn = document.getElementById('install-pwa-btn');
            if (installBtn) installBtn.style.display = 'block';
        });

        // Виявлення iOS пристроїв
        function checkIos() {
            isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
            // Показуємо кнопку для iOS користувачів завжди (так як передзапиту немає)
            if (isIos && !window.navigator.standalone) {
                const installBtn = document.getElementById('install-pwa-btn');
                if (installBtn) installBtn.style.display = 'block';
            }
        }

        function triggerInstall() {
            if (isIos) {
                // Відкриваємо кастомну інструкцію для Apple
                document.getElementById('ios-install-modal').style.display = 'flex';
                if (window.umami) umami.track('click-install-ios-modal');
            } else if (deferredPrompt) {
                // Запускаємо системний діалог Google Chrome
                deferredPrompt.prompt();
                if (window.umami) umami.track('click-install-pwa-prompt');
                
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') {
                        console.log('User accepted the install prompt');
                        if (window.umami) umami.track('install-pwa-success');
                    } else {
                        console.log('User dismissed the install prompt');
                    }
                    deferredPrompt = null;
                    const installBtn = document.getElementById('install-pwa-btn');
                    if (installBtn) installBtn.style.display = 'none';
                });
            }
        }

        function closeIosModal() {
            document.getElementById('ios-install-modal').style.display = 'none';
        }

        window.onload = function() {
            const savedLang = localStorage.getItem('prybambas_lang') || 'en';
            document.getElementById('lang-selector').value = savedLang;
            changeLang();
            checkIos(); // Перевіряємо пристрій

            // Register PWA Service Worker
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('./sw.js')
                    .then(reg => console.log('Service Worker Registered!', reg))
                    .catch(err => console.log('Service Worker Failed!', err));
            }
        }
    </script>
</body>
</html>
