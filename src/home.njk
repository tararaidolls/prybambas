    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Geologica:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        /* Стиль «Блокнот дослідника»: папір у клітинку, чорнило, різограф-кольори */
        :root {
            --paper: #FBFCFE;
            --grid: #DCE7F4;
            --ink: #1A1A2E;
            --ink-soft: #4A4D66;
            --pink: #FF48B0;
            --pink-ink: #D61F86;
            --blue: #0078BF;
            --yellow: #FFE800;
            --card: #FFFFFF;
            --f-main: 'Geologica', 'Segoe UI', system-ui, -apple-system, sans-serif;
            --f-hand: 'Caveat', 'Comic Sans MS', cursive;
            color-scheme: light;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { min-height: 100%; }

        body {
            background-color: var(--paper);
            background-image:
                linear-gradient(var(--grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
            background-size: 24px 24px;
            color: var(--ink);
            font-family: var(--f-main);
            line-height: 1.5;
            overflow-x: hidden;
        }

        .page {
            max-width: 1040px;
            margin: 0 auto;
            padding-inline: 20px;
            padding-block: 16px 40px;
            display: flex;
            flex-direction: column;
            gap: 40px;
            min-height: 100vh;
        }

        /* Верхня панель */
        .top-bar {
            display: flex; justify-content: space-between; align-items: center;
            gap: 12px; flex-wrap: wrap;
            padding-top: env(safe-area-inset-top, 0px);
        }
        .brand {
            display: flex; align-items: center; gap: 10px;
            color: var(--ink); text-decoration: none;
            font-weight: 800; font-size: 1.35rem; letter-spacing: 0.01em;
        }
        .brand svg { width: 34px; height: 34px; flex-shrink: 0; }
        .top-actions { display: flex; gap: 10px; align-items: center; }
        .top-nav { display: flex; gap: 4px; margin-inline-start: auto; }
        .top-nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.95rem; padding: 6px 12px; border-radius: 6px; }
        .top-nav a:hover { background: #FFF9C2; }
        .top-nav a:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
        @media (max-width: 560px) { .top-nav { order: 3; width: 100%; margin-inline-start: 0; } .top-actions { margin-inline-start: auto; } }

        .lang-switch {
            background: var(--card);
            border: 1.5px solid var(--ink);
            color: var(--ink);
            padding: 7px 12px;
            border-radius: 8px;
            font: 600 0.88rem var(--f-main);
            cursor: pointer;
            box-shadow: 3px 3px 0 var(--blue);
        }

        .install-btn {
            background: var(--ink);
            border: 1.5px solid var(--ink);
            color: #fff;
            padding: 7px 14px;
            border-radius: 8px;
            font: 600 0.88rem var(--f-main);
            cursor: pointer;
            display: none; /* Показується тільки коли PWA готовий до встановлення */
            box-shadow: 3px 3px 0 var(--pink);
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .install-btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--pink); }

        .lang-switch:focus-visible, .install-btn:focus-visible, .space-card:focus-visible, .ios-modal-close:focus-visible, .foot a:focus-visible {
            outline: 3px solid var(--blue); outline-offset: 3px;
        }

        /* Герой */
        .hero { position: relative; display: grid; gap: 16px; max-width: 720px; padding-top: 12px; }
        .hero h1 {
            font-size: clamp(2.2rem, 6vw, 3.9rem);
            line-height: 1.04; font-weight: 800; letter-spacing: -0.02em;
            text-wrap: balance;
        }
        .hero h1 mark {
            color: inherit;
            background: linear-gradient(transparent 56%, var(--yellow) 56%, var(--yellow) 92%, transparent 92%);
            padding: 0 0.08em;
        }
        .hero p { font-size: 1.12rem; color: var(--ink-soft); max-width: 52ch; }

        .hand {
            font-family: var(--f-hand); font-weight: 700; color: var(--pink-ink);
            font-size: 1.6rem; line-height: 1;
        }
        .hero-note {
            position: absolute; top: 18px; inset-inline-end: -220px; width: 190px;
            text-align: center; transform: rotate(-5deg);
        }
        .hero-note svg { display: block; margin: 6px auto 0; width: 70px; height: 44px; }
        [dir="rtl"] .hero-note svg { transform: scaleX(-1); }
        [dir="rtl"] .card-tag { letter-spacing: 0; }
        @media (max-width: 1100px) {
            .hero-note { position: static; width: auto; text-align: start; transform: rotate(-2deg); }
            .hero-note svg { display: none; }
        }

        /* Картки просторів */
        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 26px 20px;
        }

        .space-card {
            position: relative;
            background: var(--card);
            border: 1.5px solid var(--ink);
            border-radius: 6px;
            padding: 22px 18px 18px;
            display: flex; flex-direction: column; gap: 8px;
            color: var(--ink); text-decoration: none;
            box-shadow: 4px 4px 0 var(--ink);
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .space-card:hover { transform: translate(-2px, -2px) rotate(-0.4deg); box-shadow: 6px 6px 0 var(--ink); }
        .space-card:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ink); }

        /* Скотч зверху */
        .space-card::before {
            content: ""; position: absolute; top: -10px; left: 50%;
            width: 64px; height: 18px; transform: translateX(-50%) rotate(var(--tilt, -3deg));
            background: var(--tape); opacity: var(--tape-op, 0.75);
        }

        .card-ico { position: relative; width: 64px; height: 64px; }
        .card-ico::before {
            content: ""; position: absolute; width: 46px; height: 46px; border-radius: 50%;
            right: -2px; bottom: 0; background: var(--spot); opacity: 0.85; mix-blend-mode: multiply;
        }
        .card-ico svg { position: relative; width: 64px; height: 64px; }

        .card-tag {
            font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
            color: var(--blue);
        }
        .card-title { font-size: 1.22rem; font-weight: 800; line-height: 1.2; }
        .card-desc { font-size: 0.95rem; color: var(--ink-soft); }

        /* Нові ідеї та зошити */
        .teasers { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .teaser { background: var(--card); border: 1.5px solid var(--ink); border-radius: 6px; padding: 16px 18px; box-shadow: 4px 4px 0 var(--pink); min-width: 0; }
        .teaser:nth-child(2) { box-shadow: 4px 4px 0 var(--blue); }
        .teaser-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
        .teaser-head h2 { font-size: 1.15rem; font-weight: 800; }
        .teaser-head a { font-size: 0.9rem; font-weight: 600; color: var(--ink); text-decoration-color: var(--pink); text-underline-offset: 3px; }
        .teaser ul { list-style: none; display: grid; }
        .teaser li + li { border-top: 1.5px dashed var(--grid); }
        .teaser li a { display: grid; gap: 2px; padding: 9px 0; color: var(--ink); text-decoration: none; font-weight: 700; line-height: 1.3; }
        .teaser li a:hover { text-decoration: underline; text-decoration-color: var(--pink); }
        .teaser li small { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--blue); }

        /* Підвал */
        .foot {
            margin-top: auto;
            display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center;
            font-size: 0.9rem; color: var(--ink-soft);
            border-top: 1.5px dashed var(--grid); padding-top: 16px;
        }
        .foot a { color: var(--ink); font-weight: 600; text-decoration-color: var(--pink); text-underline-offset: 3px; }

        /* Діалогове вікно-інструкція для iOS (iPhone) */
        .ios-modal {
            position: fixed; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); left: 50%; transform: translateX(-50%);
            width: 90%; max-width: 380px;
            background: var(--card);
            border: 1.5px solid var(--ink);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 5px 5px 0 var(--pink);
            z-index: 1000;
            display: none;
            flex-direction: column; gap: 12px;
            animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes slide-up {
            from { transform: translate(-50%, 100px); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }
        .ios-modal h3 { font-size: 1.1rem; font-weight: 800; text-align: center; }
        .ios-modal p { font-size: 0.92rem; line-height: 1.4; color: var(--ink-soft); text-align: center; }
        .ios-modal-step {
            display: flex; align-items: center; gap: 10px;
            background: var(--paper); border: 1px solid var(--grid);
            padding: 10px 14px; border-radius: 6px;
            font-size: 0.88rem; font-weight: 600;
        }
        .ios-modal-step span.icon { font-size: 1.3rem; }
        .ios-modal-close {
            background: var(--ink); border: none; color: #fff; padding: 9px;
            border-radius: 6px; font: 600 0.88rem var(--f-main); cursor: pointer; margin-top: 4px;
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation: none !important; transition: none !important; }
        }
    </style>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="8460fd7f-da31-46c7-8c9d-eff5e64399cc"></script>
<link rel="stylesheet" href="/assets/seo-info.css">
