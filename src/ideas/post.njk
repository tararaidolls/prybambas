---js
{
  pagination: { data: "catalog.postPages", size: 1, alias: "I" },
  permalink: (data) => data.I.url,
  layout: "base.njk",
  section: "ideas",
  ogType: "article",
  eleventyComputed: {
    lang: (data) => data.I.lang,
    alternates: (data) => data.I.alternates,
    pageTitle: (data) => data.I.t.title,
    description: (data) => data.I.t.summary || data.I.t.social,
    ogImage: (data) => data.I.post.cover,
    // Розмітка статті для Google і AI-пошуку
    jsonld: (data) => ({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: data.I.t.title,
      description: data.I.t.summary || data.I.t.social,
      datePublished: new Date(data.I.post.date).toISOString().slice(0, 10),
      inLanguage: data.I.lang,
      url: new URL(data.I.url, data.site.url).href,
      image: new URL(data.I.post.cover || "/logo.png", data.site.url).href,
      author: { "@type": "Organization", name: "Prybambas", url: data.site.url },
      publisher: { "@type": "Organization", name: "Prybambas", url: data.site.url, logo: { "@type": "ImageObject", url: new URL("/logo.png", data.site.url).href } },
      audience: { "@type": "Audience", audienceType: "Parents and teachers of children ages 5-14" },
    }),
  },
}
---
{%- from "macros.njk" import productCard -%}
{%- set t = i18n[I.lang] -%}
<p class="crumbs"><a href="/{{ I.lang }}/ideas/">{{ t.ideas_title }}</a></p>
<article class="post">
  <p class="i-date">{{ t.published }} {{ I.post.date | dateLocal(I.lang) }}</p>
  <h1>{{ I.t.title }}</h1>
  {% if I.post.cover %}<img class="post-cover" src="{{ I.post.cover }}" alt="">{% endif %}
  <div class="prose">{{ I.t.html | safe }}</div>
  {% if I.gameUrl %}<a class="game-link" href="{{ I.gameUrl }}">▶ {{ t.try_game }}</a>{% endif %}
</article>
{% if I.product %}
<section class="block">
  <div class="block-head"><h2>{{ t.related_product }}</h2></div>
  <div class="p-grid p-grid-one">{{ productCard(I.product, t, I.lang) }}</div>
</section>
{% endif %}
