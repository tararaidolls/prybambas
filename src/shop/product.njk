---js
{
  pagination: { data: "catalog.productPages", size: 1, alias: "P" },
  permalink: (data) => data.P.url,
  layout: "base.njk",
  ogAuto: true,
  section: "shop",
  ogType: "product",
  eleventyComputed: {
    lang: (data) => data.P.lang,
    alternates: (data) => data.P.alternates,
    pageTitle: (data) => data.P.t.title,
    description: (data) => data.P.t.tagline || data.P.t.title,
    ogImage: (data) => data.P.product.cover,
    gumroad: (data) => data.P.product.editions.some((e) => e.buttons.some((b) => b.platform === "gumroad")),
    // Розмітка для Google. Google вимагає, щоб у Product була ціна (offers), тому:
    //  - товар у продажу з цінами в оголошеннях (знімки магазинів) → Product з Offer на кожне оголошення;
    //  - без цін (напр. «скоро») → Book для зошитів і щоденників або CreativeWork — для них ціна не потрібна.
    jsonld: (data) => {
      const p = data.P.product;
      const base = {
        "@context": "https://schema.org",
        name: data.P.t.title,
        description: data.P.t.tagline || "",
        url: new URL(data.P.url, data.site.url).href,
        image: p.cover ? new URL(p.cover, data.site.url).href : undefined,
        inLanguage: data.P.editionLangs,
      };
      if (p.status === "available" && p.offers.length) {
        return {
          ...base, "@type": "Product",
          brand: { "@type": "Brand", name: "Kids Skill Academy" },
          offers: p.offers.map((o) => ({
            "@type": "Offer", price: o.price, priceCurrency: o.currency, url: o.url,
            availability: o.preorder ? "https://schema.org/PreOrder" : "https://schema.org/InStock",
          })),
        };
      }
      return {
        ...base,
        "@type": ["workbook", "journal", "diary", "book"].includes(p.type) ? "Book" : "CreativeWork",
        publisher: { "@type": "Organization", name: "Kids Skill Academy" },
        author: { "@type": "Person", name: "Maryna Skliar" },
      };
    },
  },
}
---
{%- from "macros.njk" import cover, productCard, postCard -%}
{%- set t = i18n[P.lang] -%}
{%- set p = P.product -%}
<p class="crumbs"><a href="/{{ P.lang }}/shop/">{{ t.shop_title }}</a> / <a href="{{ P.seriesUrl }}">{{ P.seriesT.title }}</a></p>

<article class="product">
  <div class="product-cover">
    {{ cover({cover: p.cover, color: P.color, title: P.t.title, seriesTitle: P.seriesT.title, status: p.status}, t, "big") }}
    {% if p.images.length %}<div class="thumbs">{% for img in p.images %}<img src="{{ img }}" alt="" loading="lazy">{% endfor %}</div>{% endif %}
  </div>

  <div class="product-main">
    <h1>{{ P.t.title }}</h1>
    {% if P.t.tagline %}<p class="lead">{{ P.t.tagline }}</p>{% endif %}
    <p class="p-meta">
      {%- if p.type %}<span>{{ t.types[p.type] or p.type }}</span>{% endif -%}
      {%- if p.ages %}<span>{{ t.ages | fmt({ages: p.ages}) }}</span>{% endif -%}
    </p>

    {% if p.status == "coming-soon" %}
      <p class="soon-note">{{ t.coming_soon }}</p>
    {% endif %}

    {% if p.editions.length %}
    <div class="buy">
      {% for e in p.editions %}{% set btns = e.buttons | forLang(P.lang) %}{% if btns.length or e.pages or e.title %}
      <div class="edition">
        <div class="edition-head">
          {% if e.lang %}<b>{{ e.lang | langName(P.lang) }}</b>{% endif %}
          {% if e.title %}<span>{{ e.title }}</span>{% endif %}
          {% if e.pages %}<span>{{ t.pages | fmt({n: e.pages}) }}</span>{% endif %}
          {% if e.price %}<span class="price">{{ e.price }}</span>{% endif %}
        </div>
        <div class="edition-btns">
          {% for b in btns %}
          <a class="btn {% if b.print %}btn-ghost{% endif %}" href="{{ b.url }}" {% if b.platform != 'site' %}target="_blank" rel="noopener"{% endif %} data-umami-event="buy-{{ b.platform }}" data-umami-event-product="{{ p.slug }}">
            <small>{{ t.formats[b.format] or (t.buy_print if b.print else t.buy_digital) }}</small>{{ t.buy_on | fmt({store: b.label}) }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>
    {% endif %}

    {% if P.skills.length %}<p class="browse-row">{% for k in P.skills %}<a class="chip" href="/{{ P.lang }}/skills/{{ k }}/">{{ t.skills[k].name }}</a>{% endfor %}</p>{% endif %}

    {% if P.gameUrl %}<a class="game-link" href="{{ P.gameUrl }}">▶ {{ t.try_game }}</a>{% endif %}

    {% if P.t.html %}<div class="prose">{{ P.t.html | safe }}</div>{% endif %}
  </div>
</article>

{% if P.ideas.length %}
<section class="block">
  <div class="block-head"><h2>{{ t.related_ideas }}</h2></div>
  <div class="i-grid">{% for i in P.ideas %}{{ postCard(i, t, P.lang) }}{% endfor %}</div>
</section>
{% endif %}
{% if P.more.length %}
<section class="block">
  <div class="block-head"><h2>{{ t.more_in_series }}</h2></div>
  <div class="p-grid">{% for o in P.more %}{{ productCard(o, t, P.lang) }}{% endfor %}</div>
</section>
{% endif %}
