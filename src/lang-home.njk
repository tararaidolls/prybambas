---js
{
  pagination: { data: "catalog.langPages", size: 1, alias: "L" },
  permalink: (data) => `/${data.L.lang}/`,
  layout: "base.njk",
  eleventyComputed: {
    lang: (data) => data.L.lang,
    alternates: (data) => data.L.altHome,
  },
}
---
{%- from "macros.njk" import productCard, postCard -%}
{%- set t = i18n[L.lang] -%}
<section class="hero">
  <h1>{{ t.home_title }}</h1>
  <p>{{ t.home_intro }}</p>
  <div class="hero-links">
    <a class="btn" href="/">{{ t.play_online }}</a>
    <a class="btn btn-ghost" href="/{{ L.lang }}/shop/">{{ t.nav_shop }}</a>
  </div>
</section>

{% if L.posts.length %}
<section class="block">
  <div class="block-head"><h2>{{ t.latest_ideas }}</h2><a href="/{{ L.lang }}/ideas/">{{ t.all_ideas }} →</a></div>
  <div class="i-grid">{% for p in L.posts | batch(4) | first %}{{ postCard(p, t, L.lang) }}{% endfor %}</div>
</section>
{% endif %}

<section class="block">
  <div class="block-head"><h2>{{ t.featured }}</h2><a href="/{{ L.lang }}/shop/">{{ t.all_products }} →</a></div>
  <div class="p-grid">{% for p in (L.featured if L.featured.length else L.products) | batch(6) | first %}{{ productCard(p, t, L.lang) }}{% endfor %}</div>
</section>
